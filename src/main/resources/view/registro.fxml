<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="470.0" prefWidth="400.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kinal.reclutamiento.controller.RegistroController">
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Crear cuenta" />
      <TextField fx:id="txtNombre" promptText="Nombre" />
      <TextField fx:id="txtApellido" promptText="Apellido" />
      <TextField fx:id="txtCorreo" promptText="Correo electrónico" />
      <PasswordField fx:id="txtPassword" promptText="Contraseña (mínimo 6 caracteres)" />
      <ComboBox fx:id="cmbRol" maxWidth="Infinity" promptText="Seleccione un rol" />
      <Button defaultButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#onRegistrar" text="Registrarse" />
      <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onVolver" text="Volver al inicio de sesión" />
   </children>
</VBox>
